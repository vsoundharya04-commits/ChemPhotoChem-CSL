<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0"
       class="in-text"
       default-locale="en-US">
  <info>
    <title>ChemPhotoChem (with article titles)</title>
    <id>http://www.zotero.org/styles/chemphotochem-with-article-titles</id>
    <link href="http://www.zotero.org/styles/chemphotochem-with-article-titles" rel="self"/>
    <category citation-format="numeric"/>
    <summary>Numbered references with full article titles, formatted for ChemPhotoChem.</summary>
    <updated>2026-11-12T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <locale xml:lang="en">
    <terms>
      <term name="et-al">et al.</term>
    </terms>
  </locale>

  <macro name="author">
    <names variable="author">
      <name initialize-with=". " and="text" delimiter=", " delimiter-precedes-last="always"/>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="issued-year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="journal">
    <text variable="container-title" form="short" font-style="italic"/>
  </macro>

  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography second-field-align="flush" et-al-min="7" et-al-use-first="6">
    <layout>
      <text variable="citation-number" prefix="[" suffix="] "/>
      <group delimiter=", ">
        <text macro="author"/>
        <text variable="title" quotes="true"/>
        <group delimiter=" ">
          <text macro="journal"/>
          <text macro="issued-year"/>
        </group>
        <text variable="volume" font-weight="bold"/>
        <choose>
          <if variable="page">
            <text variable="page"/>
          </if>
          <else>
            <text variable="number"/>
          </else>
        </choose>
      </group>
      <text variable="DOI" prefix=". https://doi.org/" />
    </layout>
  </bibliography>
</style>
